<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8.1"/>
    <httpRuntime targetFramework="4.8.1" requestValidationMode="2.0" maxRequestLength="1024"/>
    <pages validateRequest="false" enableViewStateMac="true" enableEventValidation="true"/>
    <authentication mode="Forms">
      <forms loginUrl="Login.aspx" timeout="60" slidingExpiration="true" protection="All" cookieless="UseCookies" cookieSameSite="Strict"/>
    </authentication>
    <httpCookies httpOnlyCookies="true" sameSite="Strict"/>
    <sessionState cookieless="UseCookies" timeout="60" cookieSameSite="Strict"/>
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff"/>
        <add name="X-Frame-Options" value="DENY"/>
        <add name="Referrer-Policy" value="same-origin"/>
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>