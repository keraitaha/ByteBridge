<%@ Page Language="C#" AutoEventWireup="true" CodeFile="Notes.aspx.cs" Inherits="Notes" %>
<!doctype html>
<html lang="en">
<head runat="server"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Notes · ByteBridge</title><link rel="stylesheet" href="styles/site.css"><script src="scripts/site.js" defer></script></head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<form id="MainForm" runat="server">
<asp:HiddenField ID="CsrfToken" runat="server" />
<header class="site-header"><div class="container header-row"><a class="brand" href="Default.aspx">Byte<span>Bridge</span></a><nav class="desktop-nav" aria-label="Main navigation"><a href="Paths.aspx">Learn</a><a href="Practice.aspx">Skill tree</a><a href="Quizzes.aspx">Quizzes</a><a href="Dashboard.aspx">My progress</a><a href="Login.aspx" id="LoginLink" runat="server">Log in</a></nav><details class="menu"><summary>Menu</summary><nav aria-label="All pages"><a href="Default.aspx">Home</a><a href="Paths.aspx">Lessons</a><a href="Practice.aspx">Skill tree</a><a href="Quizzes.aspx">Quizzes</a><a href="Results.aspx">Results</a><a href="Dashboard.aspx">Dashboard</a><a href="Notes.aspx">Notes</a><a href="Flashcards.aspx">Flashcards</a><a href="Profile.aspx">Profile</a><a href="About.aspx">About</a><a href="Admin.aspx">Admin studio</a><a href="Login.aspx">Log in</a><a href="Register.aspx">Sign up</a></nav></details><asp:Label ID="SignedInName" runat="server" CssClass="signed-in-name" /><asp:LinkButton ID="LogoutButton" runat="server" OnClick="Logout_Click" CssClass="secondary small" CausesValidation="false">Log out</asp:LinkButton></div></header>
<main id="main" class="container"><asp:Label ID="Notice" runat="server" CssClass="notice" Visible="false" />
<a class="back-link button secondary small" href="Dashboard.aspx">Back to dashboard</a>
<div class="page-heading"><h1>A place for your own words</h1><p class="muted">Keep a thought, or connect a note to a lesson.</p></div>
<asp:Panel ID="EditorPanel" runat="server" CssClass="panel"><h2><asp:Label ID="EditorHeading" runat="server" Text="Write a note" /></h2><div class="field"><asp:Label runat="server" AssociatedControlID="NoteTitle" Text="Title" /><asp:TextBox ID="NoteTitle" runat="server" MaxLength="100" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="NoteBody" Text="Your note" /><asp:TextBox ID="NoteBody" runat="server" TextMode="MultiLine" ValidateRequestMode="Disabled" Rows="5" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="LessonChoice" Text="Related lesson (optional)" /><asp:DropDownList ID="LessonChoice" runat="server" /></div><div class="actions"><asp:Button ID="SaveNote" runat="server" Text="Save note" OnClick="SaveNote_Click" /><a class="button secondary" href="Notes.aspx">Clear / cancel</a></div></asp:Panel>
<div class="section-heading"><h2>Your notes</h2></div><asp:Label ID="EmptyNotes" runat="server" CssClass="empty" Text="Your first note can start with one sentence." />
<section class="panel"><asp:Repeater ID="NoteList" runat="server" OnItemDataBound="NoteList_ItemDataBound" OnItemCommand="NoteList_ItemCommand"><ItemTemplate><article class="record"><p class="muted"><asp:Label ID="RelatedLesson" runat="server" /></p><h3><asp:Label ID="SavedTitle" runat="server" /></h3><p class="lesson-text"><asp:Label ID="SavedBody" runat="server" /></p><div class="record-actions"><asp:HyperLink ID="EditLink" runat="server" CssClass="button secondary small" Text="Edit" /><asp:LinkButton ID="DeleteLink" runat="server" CommandName="Remove" CssClass="button danger small" Text="Delete" data-confirm="Delete this note? This cannot be undone." /></div></article></ItemTemplate></asp:Repeater></section>

</main>
<footer class="footer container">ByteBridge. Small steps. Real understanding. <a href="About.aspx">About this project</a></footer>
